    function TrackAttributes(Character)
        if not Character then return end
        Character:GetAttributeChangedSignal('PursuitState'):Connect(function()
            if (Character:GetAttribute('PursuitState') == 'Dashing') then
                Forsaken.PursuitTracker = tick()
                if (IsKiller() and Skidsaken.Flags.DemonicPursuitNoclip.CurrentValue) then
                    EnableNoclip()
                    repeat wait() until not LocalPlayer.Character or LocalPlayer.Character:GetAttribute('PursuitState') ~= 'Dashing' or not IsKiller()
                    DisableNoclip()
                end
            end
        end)
        Character:GetAttributeChangedSignal('VoidRushState'):Connect(function()
            if (Character:GetAttribute('VoidRushState') == 'Dashing') then
                Forsaken.VoidRushTracker = tick()
                task.spawn(function()
                    while (LocalPlayer.Character:GetAttribute('VoidRushState') == 'Dashing' and wait()) do
                        if (IsKiller() and AimbotValues['Void Rush']) then
                            local closest = GetClosestSurvivor(Skidsaken.Flags.VoidRushThreshold.CurrentValue)
                            if closest then
                                StartAimbotting(closest, function()
                                    return IsKiller() and LocalPlayer.Character:GetAttribute('VoidRushState') == 'Dashing'
                                end, nil, nil, true)
                            end
                            StartAimbotting()
                        end
                    end
                end)
                if (IsKiller() and Skidsaken.Flags.VoidRushNoclip.CurrentValue) then
                    EnableNoclip()
                    repeat wait() until not LocalPlayer.Character or LocalPlayer.Character:GetAttribute('VoidRushState') ~= 'Dashing' or not IsKiller()
                    DisableNoclip()
                end
            end
        end)
        local conn
        local hrp = Character:WaitForChild('HumanoidRootPart', 7)
        conn = hrp and hrp.ChildAdded:Connect(function(child)
            if child:IsA("LinearVelocity") then
                if (Unloaded) then return end
                if (Character.Name ~= 'c00lkidd' or not Skidsaken.Flags.FlyOverride.CurrentValue) then
                    return
                end
                child.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                local updateConn
                updateConn = RunService.Heartbeat:Connect(function()
                    local lookVec = Camera.CFrame.LookVector
                    if not child.Parent then
                        updateConn:Disconnect()
                        return
                    end
                    if Forsaken.UsingWalkspeedOverride then
                        child.VectorVelocity = lookVec * c00lkiddConfig.WalkspeedOverrideSpeed
                        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + lookVec)
                    else
                        child:Destroy()
                    end
                end)

                child.AncestryChanged:Connect(function(_, parent)
                    if not parent then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end)
            end
        end)
    end
