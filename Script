                        Forsaken.CurrentChaseTheme.SoundId = Forsaken.CurrentChaseTheme.Name
                    end
                end
            end
        })

        AudioTab:CreateInput({
            Name = "Custom Chase ID",
            CurrentValue = isfile("Skidsaken/CustomChaseID") and readfile("Skidsaken/CustomChaseID") or "",
            PlaceholderText = "Leave empty for none",
            RemoveTextAfterFocusLost = false,
            Flag = "CustomChaseID",
            Callback = function(Text)
                writefile("Skidsaken/CustomChaseID", Text)
                Changechasetheme()
            end
        })

        AudioTab:CreateInput({
            Name = "Custom Chase File",
            CurrentValue = isfile("Skidsaken/CustomChaseFile") and readfile("Skidsaken/CustomChaseFile") or "",
            PlaceholderText = "Leave empty for none",
            RemoveTextAfterFocusLost = false,
            Flag = "CustomChaseFile",
            Callback = function(text,is)
                writefile("Skidsaken/CustomChaseFile", text)
                if (text == '') then return end
                if (not isfile(text)) then
                    return Rayfield:Notify({Title = 'Incorrect file (chase changer)', Content = '"' .. text .. '" is not an existing file', Duration = 8, Image = 'ban'})
                elseif (not is) then
                    Rayfield:Notify({Title = 'Found file', Content = 'File located in workspace. Please make sure to change the selected chase theme to Custom', Duration = 8, Image = 'check'})
                    Changechasetheme()
                end
            end
        })

        AudioTab:CreateSection('Lobby Music', 'Right')
        local LobbyMusicStatus = AudioTab:CreateLabel('DOWNLOADING')

        if not isfile('LOBBY_DOWNLOAD_TOGGLE') then
            writefile('LOBBY_DOWNLOAD_TOGGLE', '1')
        end
        local NoDownload = readfile('LOBBY_DOWNLOAD_TOGGLE') == '0'
        local Files = {
            Names = {"Custom"},
            Data = {}
        }
        local LobbyMusicFail = false
        if not NoDownload then
            local s, r = pcall(function()
                return safehttpget('https://api.github.com/repos/aibabylaugh/catsaken/contents/lobby')
            end)
            if s and r then
                local Req = HttpService:JSONDecode(r)
                local loaded = 0
                for i, v in Req do
                    pcall(function()
                        local Name = v.name:sub(1, -5)
                        local Data
                        if (isfile(`Skidsaken/{Name}`)) then
                            Data = readfile(`Skidsaken/{Name}`)
                        else
                            --warn("requesting")
                            Data = safehttpget(v.download_url)
                        end
                        if not Data then return end
                        wait()
                        Files.Data[Name] = Data
                        table.insert(Files.Names, Name)
                    end)
                    loaded = loaded + 1
                    LobbyMusicStatus:Set('DOWNLOADING ' .. loaded .. '/' .. #Req)
                end
                LobbyMusicStatus:Set('Downloaded ' .. #Req .. ' lobby music files')
            else
                LobbyMusicFail = true
                LobbyMusicStatus:Set('Lobby music failed to download (http error)')
            end
        end
        if not NoDownload and not LobbyMusicFail then
            AudioTab:CreateDropdown({
                Name = 'Lobby music theme',
                Options = Files.Names,
                CurrentOption = {SelectedLobbyMusic},
                Flag = 'LobbyMusicSelectedTheme',
                Callback = function(Options)
                    repeat wait() until Skidsaken.Flags.LastManStandingChanger ~= nil
                    local Name = Options[1]
                    writefile("Skidsaken/Selectedlobbymusic", Name)
                    SelectedLobbyMusic = Name
                    if (Name ~= 'Custom') then
                        local Data = Files.Data[Name]
                        if (Data and not isfile(`Skidsaken/{Name}`)) then
                            warn("writing lobby music")
                            writefile(`Skidsaken/{Name}`, Data)
                        end
                    end
                    if (Skidsaken.Flags.LobbyMusicChanger.CurrentValue) then
                        Changelobbymusic()
                    end
                end
            })

            AudioTab:CreateInput({
                Name = "Custom Lobby Music ID",
                CurrentValue = isfile("Skidsaken/CustomLobbyID") and readfile("Skidsaken/CustomLobbyID") or "",
                PlaceholderText = "Leave empty for none",
                RemoveTextAfterFocusLost = false,
                Flag = "CustomLobbyID",
                Callback = function(Text)
                    writefile("Skidsaken/CustomLobbyID", Text)
                    Changelobbymusic()
                end
            })

            AudioTab:CreateInput({
                Name = "Custom Lobby Music File",
                CurrentValue = isfile("Skidsaken/CustomLobbyFile") and readfile("Skidsaken/CustomLobbyFile") or "",
                PlaceholderText = "Leave empty for none",
                RemoveTextAfterFocusLost = false,
                Flag = "CustomLobbyFile",
                Callback = function(text,is)
                    writefile("Skidsaken/CustomLobbyFile", text)
                    if (text == '') then return end
                    if (not isfile(text)) then
                        return Rayfield:Notify({Title = 'Incorrect file (lobby music changer)', Content = '"' .. text .. '" is not an existing file', Duration = 8, Image = 'ban'})
                    elseif (not is) then
                        Rayfield:Notify({Title = 'Found file', Content = 'File located in workspace. Please make sure to change the selected lobby music to Custom', Duration = 8, Image = 'check'})
                    end
                    Changelobbymusic()
                end
            })

            AudioTab:CreateToggle({
                Name = 'Change Lobby Music',
                CurrentValue = isfile("Skidsaken/LobbyMusicChanger"),
                Flag = 'LobbyMusicChanger',
                Callback = function(Callback)
                    if (Callback) then
                        task.spawn(function()
                            writefile("Skidsaken/LobbyMusicChanger", "")
                        end)
                        Changelobbymusic()
                    else
                        task.spawn(function()
                            delfile("Skidsaken/LobbyMusicChanger")
                        end)
                        if Forsaken.CurrentLobbyMusic then
                            Forsaken.CurrentLobbyMusic.SoundId = Forsaken.CurrentLobbyMusic:GetAttribute('RealId')
                        end
                    end
                end
            })

            AudioTab:CreateToggle({
                Name = '[Disable Lobby Music Downloads]',
                Flag = 'LobbyMusicDisabledDownloads',
                CurrentValue = NoDownload,
                Callback = function(C)
                    writefile('LOBBY_DOWNLOAD_TOGGLE', C and '0' or '1')
                end
            })
        end
    end

    --tracksound
    IngamePlayers.DescendantAdded:Connect(function(v)
        if (Unloaded) then return end
        pcall(function()
            local SN = v.Parent.Parent:GetAttribute("SkinName")
            if SN == "" then
                SN = nil
            end
            local DefaultGuest = require(MainSurvivorsPath.Guest1337.Config)
            local GuestInfo = SN and require(ReplicatedStorage.Assets.Skins.Survivors.Guest1337[SN].Config) or DefaultGuest
            local Char = LocalPlayer.Character
            if v:IsA("Sound") and v.Name == "rbxassetid://109931874166612" and Skidsaken.Flags.SilenceRageSFX.CurrentValue then
                v:Destroy()
            end
            if v:IsA("Sound") and v.Name == ((GuestInfo.Sounds and GuestInfo.Sounds.BlockSuccess) and GuestInfo.Sounds.BlockSuccess or DefaultGuest.Sounds.BlockSuccess) then
                local changed = false
                if audiochanger_Block_Id ~= "" then
                    changed = true
                    InterceptAudio(v, audiochanger_Block_Id)
                end
                if audiochanger_Block_File ~= "" and not changed then
                    InterceptAudio(v, audiochanger_Block_File)
                end
            end
            if v:IsA("Sound") and v.SoundId == ((GuestInfo.Sounds and GuestInfo.Sounds.Parry) and GuestInfo.Sounds.Parry or DefaultGuest.Sounds.Parry) then
                local changed = false
                if audiochanger_Parry_Id ~= "" then
                    changed = true
                    InterceptAudio(v, audiochanger_Parry_Id)
                end
                if audiochanger_Parry_File ~= "" and not changed then
                    InterceptAudio(v, audiochanger_Parry_File)
                end
            end
            if v:IsA("Sound") and v.SoundId == ((GuestInfo.Sounds and GuestInfo.Sounds.Punch) and GuestInfo.Sounds.Punch or DefaultGuest.Sounds.Punch) then
                local changed = false
                if audiochanger_Punch_Id ~= "" then
                    changed = true
                    InterceptAudio(v, audiochanger_Punch_Id)
                end
                if audiochanger_Punch_File ~= "" and not changed then
                    InterceptAudio(v, audiochanger_Punch_File)
                end
            end
            if v:IsA("Sound") and table.find(Forsaken.AutoBlockSounds, v.SoundId) and v.Parent.Parent ~= LocalPlayer.Character then
                local KillerModel = Forsaken.Killers[1]
                function GetHitboxes()
                    local Num = 0
                    for i, Hitbox in workspace.Hitboxes:GetChildren() do
                        if (Hitbox.Name:sub(1, -7) == KillerModel:GetAttribute('Username')) then
                            Num += 1
                        end
                    end
                    return Num
                end
                task.spawn(function()
                    if not KillerModel then return end
                    DoAntiHit = true
                    repeat wait() until GetHitboxes() > 0
                    while GetHitboxes() > 0 do wait() end
                    wait(.4)
                    DoAntiHit = false
                end)
                if (KillerModel ~= nil and (LocalPlayer.Character.Name == 'Guest1337' or LocalPlayer.Character.Name == '007n7') and v.Parent.Parent.Parent == Killers and Skidsaken.Flags.AutoBlockSounds.CurrentValue) then
                    local TRoot = KillerModel.HumanoidRootPart
                    local LRoot = LocalPlayer.Character.HumanoidRootPart
                    local mag = (LRoot.Position - TRoot.Position).Magnitude
                    --warn("[auto block] sound dwetewcted uwu")
                    if (HasAbilityReady("Block") and (not IsKiller()) and Skidsaken.Flags.AutoBlockToggle.CurrentValue) then
                        local startedtime = tick()
                        while v.IsPlaying and tick() - startedtime <= Forsaken.HitboxesDuration do -- this is roughly the time that hitboxes stop working
                            if Counter(KillerModel, LRoot, track, tick()) then break end
                            wait()
                        end
                    elseif (HasAbilityReady('Clone') and Skidsaken.Flags.AutoCloneToggle.CurrentValue) then
                        if mag <= Skidsaken.Flags.RagingPaceRange.CurrentValue and (mag <= 5 or not Skidsaken.Flags.RagingPaceFaceCheck.CurrentValue or IsFacing2(LRoot, TRoot, 0.707, 1)) then
                            Clone()
                        end
                    end
                end
            end
        end)
    end)

    workspace.Themes.ChildAdded:Connect(function(Sound)
        if (Sound.Name == 'LastSurvivor' and Skidsaken.Flags.LastManStandingChanger.CurrentValue) then
            Forsaken.CurrentLms = Sound
            Changelms()
        end
        if (Sound.Name == 'spectreOutside' and Skidsaken.Flags.LobbyThemeChanger.CurrentValue) then
            Forsaken.CurrentLobbyMusic = Sound
            Changelobbymusic()
        end
        if (table.find(Forsaken.ChaseThemesRaw, Sound.SoundId) and Skidsaken.Flags.ChaseChanger.CurrentValue) then
            warn("chase theming")
            Changechasetheme()
        end
    end)
