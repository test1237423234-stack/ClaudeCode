                HealthBar.Visible = false
            end

            -- Update box
            local RootPos = Camera:WorldToViewportPoint(Root.Position)

            local TopPos = Camera:WorldToViewportPoint(
                (CFrame.lookAlong(Root.Position, Camera.CFrame.LookVector) *
                CFrame.new(2, Humanoid.HipHeight, 0)).Position
            )

            local BottomPos = Camera:WorldToViewportPoint(
                (CFrame.lookAlong(Root.Position, Camera.CFrame.LookVector) *
                CFrame.new(-2, -Humanoid.HipHeight - 1, 0)).Position
            )

            local SizeX, SizeY = TopPos.X - BottomPos.X, TopPos.Y - BottomPos.Y
            local PosX, PosY = RootPos.X - SizeX / 1.5, RootPos.Y - SizeY / 1.5

            Box.Position = Vector2.new(
                PosX + SizeX / 2,
                PosY - SizeY
            )

            Box.Size = Vector2.new(SizeX / 2, SizeY * 4.5)
            Box.Color = Skidsaken.Flags[ESP.ColorFlag].Color

            BoxOutline.Size = Box.Size
            BoxOutline.Position = Box.Position

            -- Health
            HealthBar.Position = Box.Position - Vector2.new(6, 0)
            HealthBar.Size = Vector2.new(
                0,
                Box.Size.Y / (Humanoid.MaxHealth / Humanoid.Health)
            )

            HealthBar.Color = MapHealthColor(
                Humanoid.Health,
                Humanoid.MaxHealth
            )

            HealthBarOutline.Size = Vector2.new(
