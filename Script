                local TestPosition3 = Box.Position + Vector2.new(Box.Size.X / 2, 0)
                local ViewportPos = Camera:WorldToViewportPoint(Root.Position)
                local Depth = ViewportPos.Z

                Items.Size = Camera.ViewportSize.Y /
                    (2 * Depth * math.tan(math.rad(Camera.FieldOfView / 2)))

                Items.Position = Vector2.new(
                    TestPosition3.X,
                    TestPosition3.Y + 13
                )
            else
