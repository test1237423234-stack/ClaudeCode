                Highlight.OutlineTransparency = 0
            end
        end

        -- RANGES
        for Index = #RangesEsp, 1, -1 do
            local ESP = RangesEsp[Index]
            ESP.Circle.Size = Vector3.new(0.2, ESP.RangeX*2, ESP.RangeZ*2)
